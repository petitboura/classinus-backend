# Image des boîtes : ce que le code de l'élève voit. Aucun secret, aucun outil d'administration.
FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1000 user && useradd -u 1000 -g 1000 -m -d /home/user -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
CMD ["sleep", "infinity"]
